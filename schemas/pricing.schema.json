{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost77-security.onrender.com/schemas/pricing.schema.json",
  "title": "GhOsT77 Security pricing",
  "type": "object",
  "required": [
    "name",
    "website",
    "currency",
    "payout_wallet",
    "items"
  ],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "currency": {
      "type": "string"
    },
    "also_accepts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "usdc_network": {
      "type": "string"
    },
    "payout_wallet": {
      "type": "string",
      "pattern": "^0x[a-fA-F0-9]{40}$"
    },
    "payout_note": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri"
    },
    "checked_at": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "price",
          "currency",
          "billing",
          "buy_url"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "currency": {
            "type": "string"
          },
          "billing": {
            "type": "string",
            "enum": [
              "one_time",
              "monthly",
              "per_call"
            ]
          },
          "cancel_anytime": {
            "type": "boolean"
          },
          "payment_methods": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "buy_url": {
            "type": "string",
            "format": "uri"
          },
          "authorization_url": {
            "type": "string",
            "format": "uri"
          },
          "info_url": {
            "type": "string",
            "format": "uri"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "authorization_required": {
            "type": "boolean"
          },
          "x402": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
